<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 4 Parent：统一管理 Spring Framework 7 / Micrometer 等版本。
      Spring AI 2.0.x 官方基线：Spring Boot 4.0.x / 4.1.x
      文档：https://docs.spring.io/spring-ai/reference/2.0/getting-started.html
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.edy</groupId>
    <artifactId>first-ai-project</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>first-ai-project</name>
    <description>Java 架构师转 AI Agent：Spring AI 2.0 ChatClient 实战</description>

    <properties>
        <!-- Spring Boot 4 / Spring AI 2.0 要求 JDK 21+（虚拟线程、结构化并发等） -->
        <java.version>21</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
    </properties>

    <!--
      Spring AI BOM：只管理依赖版本，不引入实现。
      用法与 Spring Cloud BOM 相同 —— import scope。
      文档：https://docs.spring.io/spring-ai/reference/2.0/getting-started.html#dependency-management
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          OpenAI ChatModel 自动配置。
          注意：DeepSeek / 通义千问兼容模式也可走同一套 OpenAI 协议客户端（见 MultiModelConfig）。
          文档：https://docs.spring.io/spring-ai/reference/2.0/api/chat/openai-chat.html
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
          DeepSeek 官方 Starter（可选第二模型）。
          多模型并存时需关闭默认 ChatClient 自动配置，见 application.yml。
          文档：https://docs.spring.io/spring-ai/reference/2.0/api/chat/deepseek-chat.html
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>

        <!-- 同步 REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          WebFlux：提供 Reactor（Flux/Mono），用于 SSE 流式输出。
          Spring MVC Controller 也可直接返回 Flux，只要 classpath 有 reactor。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Actuator + Micrometer：AI 调用次数 / 延迟可观测性 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Spring Boot 4 / Framework 7：重试已进入 spring-core（org.springframework.core.retry），
          不再依赖独立的 spring-retry 库；旧 starter-aop 已更名为 starter-aspectj。
          本项目用编程式 RetryTemplate，无需 AspectJ。
          参考：https://github.com/spring-projects/spring-boot/wiki/Spring-Boot-4.0-Migration-Guide
          参考：https://spring.io/blog/2025/09/09/core-spring-resilience-features/
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
